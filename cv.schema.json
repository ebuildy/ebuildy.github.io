{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Subset of JSON Resume. additionalProperties:false keeps phone and postal address out of the public repo.",
  "definitions": {
    "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "monthOrYear": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$" },
    "url": { "type": "string", "pattern": "^https?://" },
    "text": { "type": "string", "minLength": 1 },
    "bullets": { "type": "array", "items": { "$ref": "#/definitions/text" } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["basics", "work", "skills", "education"],
  "properties": {
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "email", "summary", "location"],
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "label": { "$ref": "#/definitions/text" },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
        "url": { "$ref": "#/definitions/url" },
        "summary": { "$ref": "#/definitions/text" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["city", "country"],
          "properties": {
            "city": { "$ref": "#/definitions/text" },
            "country": { "$ref": "#/definitions/text" }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["network", "url"],
            "properties": {
              "network": { "$ref": "#/definitions/text" },
              "url": { "$ref": "#/definitions/url" }
            }
          }
        }
      }
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "position", "startDate", "highlights"],
        "properties": {
          "name": { "$ref": "#/definitions/text" },
          "position": { "$ref": "#/definitions/text" },
          "location": { "$ref": "#/definitions/text" },
          "startDate": { "$ref": "#/definitions/month" },
          "endDate": { "$ref": "#/definitions/month" },
          "summary": { "$ref": "#/definitions/text" },
          "highlights": { "$ref": "#/definitions/bullets" },
          "stack": { "$ref": "#/definitions/bullets" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "$ref": "#/definitions/text" },
          "url": { "$ref": "#/definitions/url" },
          "description": { "$ref": "#/definitions/text" }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "keywords"],
        "properties": {
          "name": { "$ref": "#/definitions/text" },
          "keywords": { "$ref": "#/definitions/bullets" }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution", "studyType", "area"],
        "properties": {
          "institution": { "$ref": "#/definitions/text" },
          "studyType": { "$ref": "#/definitions/text" },
          "area": { "$ref": "#/definitions/text" },
          "startDate": { "$ref": "#/definitions/monthOrYear" },
          "endDate": { "$ref": "#/definitions/monthOrYear" }
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "issuer"],
        "properties": {
          "name": { "$ref": "#/definitions/text" },
          "issuer": { "$ref": "#/definitions/text" },
          "date": { "$ref": "#/definitions/monthOrYear" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language"],
        "properties": {
          "language": { "$ref": "#/definitions/text" },
          "fluency": { "$ref": "#/definitions/text" }
        }
      }
    }
  }
}
