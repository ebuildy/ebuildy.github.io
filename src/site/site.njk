<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.meta.title }}</title>
  <meta name="author" content="{{ cv.basics.name }}">
  <meta name="description" content="{{ site.meta.description }}">
  <meta property="og:title" content="{{ site.meta.title }}">
  <meta property="og:description" content="{{ site.meta.description }}">
  <meta property="og:type" content="website">
  <style>{{ css | safe }}</style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  <header class="top-bar">
    <div class="top-bar-inner">
      <a href="./" class="logo"><img src="photo.jpg" alt="{{ cv.basics.name }}, home" width="44" height="44"></a>
      <nav aria-label="Main">
        {% for link in site.nav %}<a href="{{ link.href }}">{{ link.label }}</a>
        {% endfor %}
      </nav>
      <a href="cv/" class="btn-outline">View CV</a>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <h1>Hi, I'm <span>{{ cv.basics.name }}</span></h1>
          <p class="hero-role">{{ cv.basics.label }}</p>
          {% for lead in site.hero.leads %}<p class="hero-lead">{{ lead }}</p>
          {% endfor %}
          <div class="hero-actions">
            <a href="#experience" class="btn-primary">View experience</a>
            <a href="#contact" class="btn-secondary">Contact me</a>
          </div>
          <ul class="hero-signals">
            {% for signal in site.hero.signals %}<li>{{ signal }}</li>
            {% endfor %}
          </ul>
        </div>
        <dl class="hero-stats">
          {% for stat in site.hero.stats %}<div>
            <dt>{{ stat.label }}</dt>
            <dd>{{ stat.value }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>
    </section>

    <section id="experience" class="section section-alt">
      <div class="container">
        <h2>Experience</h2>
        {% for job in jobs %}
        <article class="card">
          <div class="card-heading">
            <h3>{% if site.companyLogos[job.name] %}<img class="company-logo" src="{{ site.companyLogos[job.name] }}" alt="" width="32" height="32">{% endif %}{{ job.position }}, {{ job.name }}</h3>
            <span>{{ job.location }} | {{ job.startDate | date }} - {{ (job.endDate | date) if job.endDate else "Present" }}</span>
          </div>
          {% if job.summary %}<p class="muted">{{ job.summary | trim }}</p>{% endif %}
          {% if job.highlights.length %}
          <ul class="bullets">
            {% for highlight in job.highlights %}<li>{{ highlight | trim }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if job.stack %}
          <ul class="badges" aria-label="Technologies">
            {% for tech in job.stack %}<li>{{ tech }}</li>
            {% endfor %}
          </ul>
          {% endif %}
        </article>
        {% endfor %}
        <p class="more"><a href="cv/" class="btn-primary">Full career history</a></p>
      </div>
    </section>

    <section id="skills" class="section">
      <div class="container">
        <h2>Technical skills</h2>
        <dl class="card skills">
          {% for skill in cv.skills %}<div>
            <dt>{% if site.skillEmojis[skill.name] %}<span class="emoji" aria-hidden="true">{{ site.skillEmojis[skill.name] }}</span>{% endif %}{{ skill.name }}</dt>
            <dd>{{ skill.keywords | join(", ") }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>
    </section>

    <section id="open-source" class="section section-alt">
      <div class="container">
        <h2>Open source</h2>
        <div class="grid">
          {% for group in site.openSource %}
          <div class="card">
            <h3>{{ group.title }}</h3>
            <ul class="bullets{% if group.columns == 2 %} two-columns{% endif %}">
              {% for item in group.items %}<li>{% if item.url %}<a href="{{ item.url }}">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}{% if item.text %}: {{ item.text }}{% endif %}</li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="container contact">
        <h2>Contact</h2>
        <p class="muted">{{ site.contact.text }}</p>
        <p class="hero-actions">
          <a href="mailto:{{ cv.basics.email }}" class="btn-primary">{{ cv.basics.email }}</a>
          <a href="cv.pdf" class="btn-ghost">Download CV (PDF)</a>
        </p>
        <ul class="links">
          {% for profile in cv.basics.profiles %}<li><a href="{{ profile.url }}">{{ profile.url | displayUrl }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </section>
  </main>

  <footer class="footer">{{ cv.basics.name }} | {{ cv.basics.location.city }}, {{ cv.basics.location.country }}</footer>
</body>
</html>
