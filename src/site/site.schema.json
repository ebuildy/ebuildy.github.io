{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "strings": { "type": "array", "items": { "$ref": "#/definitions/text" } },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/definitions/text" },
        "label": { "$ref": "#/definitions/text" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "$ref": "#/definitions/text" },
        "href": { "$ref": "#/definitions/text" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "url": { "type": "string", "pattern": "^https?://" },
        "text": { "$ref": "#/definitions/text" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "nav", "hero", "experience", "openSource", "contact"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" }
      }
    },
    "nav": { "type": "array", "items": { "$ref": "#/definitions/link" } },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leads", "signals", "stats"],
      "properties": {
        "leads": { "$ref": "#/definitions/strings" },
        "signals": { "$ref": "#/definitions/strings" },
        "stats": { "type": "array", "items": { "$ref": "#/definitions/stat" } }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": { "limit": { "type": "integer", "minimum": 1 } }
    },
    "openSource": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "items"],
        "properties": {
          "title": { "$ref": "#/definitions/text" },
          "items": { "type": "array", "items": { "$ref": "#/definitions/item" } }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "$ref": "#/definitions/text" } }
    }
  }
}
